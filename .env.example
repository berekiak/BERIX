# Public canonical URL
NEXT_PUBLIC_SITE_URL=https://nexora-digital-rdc.vercel.app
# Server-only email configuration. A verified sender domain is needed for prospect confirmations.
RESEND_API_KEY=
NEXORA_CONTACT_EMAIL=nexoradigitalrdc@gmail.com
NEXORA_EMAIL_FROM=
# Distributed rate limiting (Upstash-compatible REST Redis); required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=
# Optional server-side, privacy-friendly analytics endpoint (e.g. self-hosted collector).
ANALYTICS_ENDPOINT=
ANALYTICS_TOKEN=
# Optional Search Console ownership verification
GOOGLE_SITE_VERIFICATION=
